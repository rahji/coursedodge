{
  "manifest_version": 3,
  "name": "Coursedodge",
  "version": "1.0",
  "description": "Removes 'disable' attributes on coursedog.com domains.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.coursedog.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
